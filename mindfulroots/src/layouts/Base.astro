---
import '../styles/global.css';
import { SITE } from '../config';
import { CATEGORY_GROUPS } from '../lib/taxonomy';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD structured data object, rendered as a script tag */
  schema?: Record<string, unknown>;
  ogType?: string;
  /** Override the default OG/Twitter share image */
  image?: string;
}

const { title, description = SITE.description, schema, ogType = 'website', image = '/og-default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Brand suffix policy. On /blog/ and /products/ the SERP title is the only
// conversion surface we control, and "· MoodSupplement" spends ~17 of the 60
// available characters on a brand nobody searches for yet — on the affron post
// that was 17 of 56, exactly the room the branded terms it ranks for needed.
// Static/marketing pages keep it, where it reads as brand rather than waste.
const path = Astro.url.pathname;
const dropsBrandSuffix = path.startsWith('/blog/') || path.startsWith('/products/');
const suffixedTitle = `${title} · ${SITE.name}`;
const fullTitle =
  title === SITE.name
    ? `${SITE.name} — ${SITE.seoTagline}`
    : dropsBrandSuffix
      ? title
      : suffixedTitle.length <= 60
        ? suffixedTitle
        : title;

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f6ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141c17" />
    {/* No-FOUC theme init — must run before the stylesheet applies */}
    <script is:inline>
      let theme = 'light';
      try {
        theme = localStorage.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (e) {}
      document.documentElement.dataset.theme = theme;
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* .ico first: Googlebot-Image probes /favicon.ico and needs a square
        raster at a multiple of 48px, which an SVG-only icon never gave it.
        Modern browsers read past it to the vector. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />


    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": new URL('/', Astro.site).toString() + '#organization',
      "name": SITE.name,
      "url": String(Astro.site),
      "logo": {
        "@type": "ImageObject",
        "url": new URL('/logo.png', Astro.site).toString(),
        "width": 600,
        "height": 60,
      },
      "sameAs": ["https://www.linkedin.com/in/enoch-cheung-ec/"],
    })} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/* Traffic-source classification. Deliberately inline and ahead of the GTM
        snippet: the classifier must win the race against GTM's Initialization
        trigger, or the entry pageview reports an empty bucket. A deferred module
        would lose that race on the session's first pageview. */}
    <script is:inline>
      (function () {
        var AI = /(chatgpt\.com|chat\.openai\.com|perplexity\.ai|claude\.ai|copilot\.microsoft\.com|gemini\.google\.com|you\.com|poe\.com)/i;
        // Anchored to real search hosts. A bare `google\.` substring also matches
        // mail./docs./tagassistant.google.com, which would silently inflate the
        // search bucket with Gmail and Docs referrals.
        var SEARCH = /^(www\.)?google\.[a-z.]{2,}$|^news\.google\.[a-z.]{2,}$|(^|\.)bing\.com$|(^|\.)duckduckgo\.com$|(^|\.)search\.yahoo\.|(^|\.)ecosia\.org$|(^|\.)search\.brave\.com$/i;
        var SOCIAL = /(^|\.)(threads\.net|threads\.com|instagram\.com|facebook\.com|t\.co|x\.com|twitter\.com|reddit\.com|linkedin\.com|pinterest\.[a-z.]{2,})$/i;
        // In-app browsers send an empty referrer but stamp the host app into the
        // UA. This is what separates social-app traffic from an LLM desktop app,
        // which has no positive fingerprint of its own.
        var INAPP = /(Instagram|Threads|Barcelona|FBAV|FBAN|Line\/|TikTok)/i;

        function hostOf(ref) {
          try { return ref ? new URL(ref).hostname : ''; } catch (e) { return ''; }
        }

        function classify() {
          var host = hostOf(document.referrer);
          var utm = '';
          try { utm = new URLSearchParams(location.search).get('utm_source') || ''; } catch (e) {}
          var operator = false;
          try { operator = localStorage.getItem('ms_op') === '1'; } catch (e) {}
          // Operator wins over every other signal: our own visits must never land
          // in the residual bucket we are trying to measure.
          if (operator) return { bucket: 'operator', host: host || '(none)' };
          // Report whichever signal matched, so raw_referrer names the AI source
          // even when the referrer is stripped but utm_source survives.
          if (AI.test(host)) return { bucket: 'ai_assistant', host: host };
          if (AI.test(utm)) return { bucket: 'ai_assistant', host: utm };
          if (host && host === location.hostname) return { bucket: 'internal', host: host };
          if (SEARCH.test(host)) return { bucket: 'search', host: host };
          if (SOCIAL.test(host)) return { bucket: 'social', host: host };
          if (!host && INAPP.test(navigator.userAgent)) return { bucket: 'social_inapp', host: '(in-app)' };
          if (host) return { bucket: 'referral', host: host };
          // Empty referrer, ordinary UA. Inferred by elimination, not detected —
          // with operator and social_inapp split out, LLM app traffic lands here.
          return { bucket: 'direct_unattributed', host: '(none)' };
        }

        // One-time operator tag: visiting /?ms_op=1 marks this browser as ours for
        // good, so our own visits stop inflating direct_unattributed.
        try {
          if (new URLSearchParams(location.search).get('ms_op') === '1') localStorage.setItem('ms_op', '1');
        } catch (e) {}

        // Classify only on the session's first pageview, so the entry source —
        // not the last internal hop — is what gets attributed. Later pageviews
        // replay the stored value rather than reclassifying.
        var seen = '';
        var seenRef = '';
        try {
          seen = sessionStorage.getItem('ms_src') || '';
          seenRef = sessionStorage.getItem('ms_ref') || '';
        } catch (e) {}

        var bucket = seen;
        var host = seenRef;
        var firstOfSession = !seen;
        if (firstOfSession) {
          var c = classify();
          bucket = c.bucket;
          host = c.host;
          try {
            sessionStorage.setItem('ms_src', bucket);
            sessionStorage.setItem('ms_ref', host);
          } catch (e) {
            // storage blocked: the push below still carries this pageview's
            // classification, it just won't persist to later pages
          }
        }

        window.dataLayer = window.dataLayer || [];
        // Push the bucket on EVERY pageview, not just the first. The data layer
        // resets on each page load, so a once-per-session push would leave every
        // later page's tags reading undefined. Deliberately not a Custom
        // JavaScript variable reading sessionStorage: GTM compiles those with the
        // Function() constructor, and our CSP has no 'unsafe-eval', so every CJS
        // variable silently evaluates to undefined. See scripts/GTM-SETUP.md.
        window.dataLayer.push({ source_bucket: bucket, raw_referrer: host });

        // The event itself stays once per session, so its count is a session count.
        if (firstOfSession) {
          window.dataLayer.push({ event: 'traffic_source', source_bucket: bucket, raw_referrer: host });
        }
      })();
    </script>

    <!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-M99Z4RML');</script>
<!-- End Google Tag Manager -->

  </head>

  <body class="min-h-screen flex flex-col">
  <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-M99Z4RML"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-card focus:px-3 focus:py-2 focus:rounded"
      >Skip to content</a
    >

    <header class="border-b border-mist bg-paper/90 backdrop-blur sticky top-0 z-20">
      <div class="mx-auto max-w-5xl px-5 py-4 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 21V8M12 8c0-3 2-5 5-5 0 3-2 5-5 5Zm0 0c0-3-2-5-5-5 0 3 2 5 5 5Zm0 6c0-2.4 1.6-4 4-4 0 2.4-1.6 4-4 4Zm0 0c0-2.4-1.6-4-4-4 0 2.4 1.6 4 4 4Z"
              stroke="var(--color-moss)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-display text-xl text-moss-deep">{SITE.name}</span>
        </a>

        <div class="flex items-center gap-3 sm:gap-5">
        {/* Desktop nav — hidden on mobile */}
        <nav class="hidden sm:flex items-center gap-5 text-sm" aria-label="Main">
          {/* Supplements: anchor navigates to /products/ (works with JS off);
              adjacent chevron button toggles the categories dropdown */}
          <div class="relative flex items-center gap-0.5">
            <a
              href="/products/"
              class={`hover:text-saffron-deep ${Astro.url.pathname.startsWith('/products/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
            >Supplements</a>
            <button
              type="button"
              id="supplements-toggle"
              class="p-1 -m-0.5 rounded text-ink-soft hover:text-saffron-deep focus:outline-none focus-visible:ring-2 focus-visible:ring-moss"
              aria-label="Browse supplement categories"
              aria-expanded="false"
              aria-controls="supplements-menu"
            >
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div
              id="supplements-menu"
              class="hidden absolute left-0 top-full mt-2 w-60 rounded-lg border border-mist bg-card shadow-dropdown py-2 z-30"
            >
              {CATEGORY_GROUPS.map((g) => (
                <a
                  href={`/products/#${g.id}`}
                  class="block px-4 py-2 text-sm text-ink-soft hover:text-saffron-deep hover:bg-paper-hover"
                >{g.label}</a>
              ))}
              <hr class="my-1.5 border-mist" />
              <a
                href="/products/"
                class="block px-4 py-2 text-sm font-medium text-moss-deep hover:text-saffron-deep hover:bg-paper-hover"
              >All supplements →</a>
            </div>
          </div>

          <a
            href="/guides/"
            class={`hover:text-saffron-deep ${Astro.url.pathname.startsWith('/guides/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
          >Guides</a>
          <a
            href="/blog/"
            class={`hover:text-saffron-deep ${Astro.url.pathname.startsWith('/blog/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
          >Journal</a>
          <a
            href="/about/"
            class={`hover:text-saffron-deep ${Astro.url.pathname.startsWith('/about/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
          >About</a>

          {/* Get help — kept in header for YMYL, visually secondary */}
          <a
            href="/get-help/"
            class={`text-xs pl-4 border-l border-mist hover:text-saffron-deep ${Astro.url.pathname.startsWith('/get-help/') ? 'text-saffron-deep font-medium' : 'text-ink-soft/80'}`}
          >Get help</a>
        </nav>

        {/* Search — desktop magnifier icon (mobile uses the drawer row) */}
        <a
          href="/search/"
          class={`hidden sm:inline-flex items-center justify-center w-8 h-8 rounded hover:text-saffron-deep focus:outline-none focus-visible:ring-2 focus-visible:ring-moss ${Astro.url.pathname.startsWith('/search') ? 'text-saffron-deep' : 'text-ink-soft'}`}
          aria-label="Search"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </a>

        {/* Theme toggle — visible on desktop and the mobile header bar */}
        <ThemeToggle />

        {/* Mobile hamburger — visible only on small screens */}
        <button
          id="nav-toggle"
          class="sm:hidden flex flex-col justify-center gap-[5px] w-8 h-8 p-1 rounded focus:outline-none focus:ring-2 focus:ring-moss"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span class="block h-0.5 w-full bg-moss-deep rounded transition-all" id="bar1"></span>
          <span class="block h-0.5 w-full bg-moss-deep rounded transition-all" id="bar2"></span>
          <span class="block h-0.5 w-full bg-moss-deep rounded transition-all" id="bar3"></span>
        </button>
        </div>
      </div>

      {/* Mobile nav drawer */}
      <nav
        id="mobile-nav"
        class="sm:hidden hidden flex-col border-t border-mist bg-paper/95"
        aria-label="Mobile navigation"
      >
        <a
          href="/search/"
          class={`px-5 py-3.5 text-sm border-b border-mist flex items-center gap-2 hover:text-saffron-deep hover:bg-paper-hover ${Astro.url.pathname.startsWith('/search') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Search
        </a>
        <a
          href="/products/"
          class={`px-5 py-3.5 text-sm border-b border-mist hover:text-saffron-deep hover:bg-paper-hover ${Astro.url.pathname.startsWith('/products/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
        >Supplements</a>
        {CATEGORY_GROUPS.map((g) => (
          <a
            href={`/products/#${g.id}`}
            class="pl-9 pr-5 py-2.5 text-sm border-b border-mist text-ink-soft hover:text-saffron-deep hover:bg-paper-hover"
          >{g.label}</a>
        ))}
        <a
          href="/guides/"
          class={`px-5 py-3.5 text-sm border-b border-mist hover:text-saffron-deep hover:bg-paper-hover ${Astro.url.pathname.startsWith('/guides/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
        >Guides</a>
        <a
          href="/blog/"
          class={`px-5 py-3.5 text-sm border-b border-mist hover:text-saffron-deep hover:bg-paper-hover ${Astro.url.pathname.startsWith('/blog/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
        >Journal</a>
        <a
          href="/about/"
          class={`px-5 py-3.5 text-sm border-b border-mist hover:text-saffron-deep hover:bg-paper-hover ${Astro.url.pathname.startsWith('/about/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
        >About</a>
        <a
          href="/contact/"
          class={`px-5 py-3.5 text-sm border-b border-mist hover:text-saffron-deep hover:bg-paper-hover ${Astro.url.pathname.startsWith('/contact/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
        >Contact</a>
        <a
          href="/get-help/"
          class={`px-5 py-3.5 text-sm border-b border-mist last:border-0 hover:text-saffron-deep hover:bg-paper-hover ${Astro.url.pathname.startsWith('/get-help/') ? 'text-saffron-deep font-medium' : 'text-ink-soft'}`}
        >Get help</a>
      </nav>
    </header>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = mobileNav?.classList.toggle('hidden') === false;
        mobileNav?.classList.toggle('flex', isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
      });
    </script>

    <script>
      const supToggle = document.getElementById('supplements-toggle');
      const supMenu = document.getElementById('supplements-menu');

      function closeSupMenu() {
        supMenu?.classList.add('hidden');
        supToggle?.setAttribute('aria-expanded', 'false');
      }

      supToggle?.addEventListener('click', () => {
        const isOpen = supMenu?.classList.toggle('hidden') === false;
        supToggle.setAttribute('aria-expanded', String(isOpen));
      });

      // Escape closes and returns focus to the toggle button
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && supToggle?.getAttribute('aria-expanded') === 'true') {
          closeSupMenu();
          supToggle.focus();
        }
      });

      // Click outside closes
      document.addEventListener('click', (e) => {
        const target = e.target as Node | null;
        if (
          supToggle?.getAttribute('aria-expanded') === 'true' &&
          target &&
          !supMenu?.contains(target) &&
          !supToggle.contains(target)
        ) {
          closeSupMenu();
        }
      });

      // Selecting a category closes the menu (matters on /products/ hash links)
      supMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeSupMenu));
    </script>

    <script>
      declare global {
        interface Window { dataLayer: Record<string, unknown>[] }
      }
      window.dataLayer = window.dataLayer || [];

      // The session's entry channel is classified by the inline script in <head>
      // (it has to run before GTM initialises). Here we only read the result.
      let sourceBucket = 'unknown';
      try {
        sourceBucket = sessionStorage.getItem('ms_src') || 'unknown';
      } catch {
        sourceBucket = 'unavailable';
      }

      // Stamp the session's entry channel onto every /go/ link so the server-side
      // click log in netlify/functions/go.mjs can attribute clicks by channel.
      // goLink() resolves at build time, so this has to happen client-side; done
      // on load rather than on click to avoid racing target="_blank".
      // Selector is href-based, not [data-affiliate], so ComparisonTable pick
      // rows are covered too.
      document.querySelectorAll<HTMLAnchorElement>('a[href^="/go/"]').forEach((a) => {
        const raw = a.getAttribute('href');
        if (!raw) return;
        const u = new URL(raw, location.origin);
        u.searchParams.set('s', sourceBucket);
        a.setAttribute('href', u.pathname + u.search);
      });

      document.addEventListener('click', (e) => {
        const el = (e.target as Element | null)?.closest?.('[data-affiliate]');
        if (!(el instanceof HTMLElement)) return;
        window.dataLayer.push({
          event: 'affiliate_click',
          product: el.dataset.product,
          placement: el.dataset.placement,
          // Comparison-table rows only: which brand in the table was clicked.
          // `product` stays the page's product slug so it groups with the other
          // placements; `variant` is undefined elsewhere and GA4 drops it.
          variant: el.dataset.variant,
        });
      });
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLElement | null;
        if (!(form instanceof HTMLFormElement) || !form.hasAttribute('data-email-form')) return;
        window.dataLayer.push({
          event: 'email_signup',
          source: form.dataset.source,
        });
      });
    </script>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t border-mist bg-moss-deep-surface text-paper-on-dark">
      <div class="mx-auto max-w-5xl px-5 py-10 grid gap-8 sm:grid-cols-3 text-sm">
        <div>
          <p class="font-display text-lg mb-2">{SITE.name}</p>
          <p class="opacity-80 leading-relaxed">{SITE.tagline}</p>
        </div>
        <div>
          <p class="eyebrow !text-mist-on-dark mb-2">Site</p>
          <ul class="space-y-1.5 opacity-90">
            <li><a href="/products/" class="hover:underline">All supplements</a></li>
            <li><a href="/guides/" class="hover:underline">Guides</a></li>
            <li><a href="/blog/" class="hover:underline">Journal</a></li>
            <li><a href="/about/" class="hover:underline">About &amp; editorial standards</a></li>
            <li><a href="/contact/" class="hover:underline">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow !text-mist-on-dark mb-2">Trust</p>
          <ul class="space-y-1.5 opacity-90">
            <li><a href="/disclosure/" class="hover:underline">Affiliate disclosure</a></li>
            <li><a href="/disclaimer/" class="hover:underline">Medical disclaimer</a></li>
            <li><a href="/get-help/" class="hover:underline">Crisis &amp; professional support</a></li>
          </ul>
        </div>
      </div>
      <div class="mx-auto max-w-5xl px-5 pb-8 text-xs leading-relaxed opacity-70 space-y-2">
        <p>
          MoodSupplement is reader-supported. When you buy through links on this site we may earn an
          affiliate commission, at no extra cost to you.
        </p>
        <p>
          Content on this site is for general information only and is not medical advice.
          Supplements are not a treatment for depression or any other medical condition. If you are
          struggling, please talk to a doctor or mental-health professional — and if you are in
          crisis, see our <a href="/get-help/" class="underline">Get help</a> page.
        </p>
        <p>© {year} {SITE.name}. These statements have not been evaluated by the FDA.</p>
      </div>
    </footer>
  </body>
</html>
