---
// Cluster-sibling links rendered at the foot of every post.
//
// Anchor text is the sibling's own title rather than "read more", because the
// anchor is the only topical signal a crawler gets about the destination before
// it decides whether the fetch is worth scheduling — and the measured problem
// here is pages Google discovered but never fetched.
import { type CollectionEntry } from 'astro:content';
import { normalizeCluster } from '../lib/taxonomy';

interface Props {
  posts: CollectionEntry<'blog'>[];
  heading?: string;
}
const { posts, heading = 'Related reading' } = Astro.props;
---
{posts.length > 0 && (
  <section class="mx-auto max-w-3xl px-5 py-4">
    <p class="eyebrow mb-3">{heading}</p>
    <ul class="grid gap-3 sm:grid-cols-2">
      {posts.map((p) => (
        <li class="h-full">
          <a
            href={`/blog/${p.id}/`}
            class="group h-full flex flex-col bg-card border border-mist rounded-lg p-4 hover:shadow-card transition-shadow"
          >
            <p class="eyebrow mb-1">{normalizeCluster(p.data.cluster)}</p>
            <span class="text-moss-deep leading-snug group-hover:text-saffron-deep">{p.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
